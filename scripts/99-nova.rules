# Stable device names for NOVA.  Install: sudo cp 99-nova.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Check IDs with: udevadm info -a -n /dev/ttyUSB0 | grep -E 'idVendor|idProduct|serial'

# RPLidar A1M8 (Silicon Labs CP2102 USB adapter)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", SYMLINK+="nova_lidar"

# Arduino Nano clone (CH340)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", SYMLINK+="nova_llc"

# Arduino Nano with FTDI chip (genuine / older boards)
KERNEL=="ttyUSB*", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE:="0666", SYMLINK+="nova_llc"
