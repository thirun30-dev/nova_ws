<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${mass/12.0*(x*x+z*z)}" iyz="0"
               izz="${mass/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass/12.0*(3*radius*radius+length*length)}" ixy="0" ixz="0"
               iyy="${mass/12.0*(3*radius*radius+length*length)}" iyz="0"
               izz="${mass/2.0*radius*radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${0.4*mass*radius*radius}" ixy="0" ixz="0"
               iyy="${0.4*mass*radius*radius}" iyz="0"
               izz="${0.4*mass*radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
