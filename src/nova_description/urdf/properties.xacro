<?xml version="1.0"?>
<!--
  ALL robot dimensions live here. Values marked MEASURE are first guesses:
  measure the real NOVA and update them here AND in nova_base/config/base.yaml
  (wheel_radius, wheel_separation) and nova_navigation/config/nav2_params.yaml (footprint).
  base_link origin = midpoint of the wheel axle. base_footprint = base_link projected to the floor.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== Drive ===== -->
  <xacro:property name="wheel_radius"     value="0.0415"/> <!-- measured 2026-11-24: 83 mm tyre diameter / 2 -->
  <xacro:property name="wheel_width"      value="0.026"/>  <!-- MEASURE -->
  <xacro:property name="wheel_separation" value="0.200"/>  <!-- measured 2026-11-23: tyre centre to tyre centre -->
  <xacro:property name="wheel_x"          value="0.0"/>    <!-- axle position along chassis (x forward) -->
  <xacro:property name="caster_x"         value="-0.085"/> <!-- MEASURE: ball caster position (negative = rear) -->
  <xacro:property name="caster_radius"    value="0.0125"/>

  <!-- ===== Chassis: hexagon, 3 layers ===== -->
  <xacro:property name="hex_length"       value="0.235"/>  <!-- 23.5 cm, vertex to vertex (x) -->
  <xacro:property name="hex_width"        value="0.215"/>  <!-- 21.5 cm, flat to flat (y) -->
  <xacro:property name="enclosure_height" value="0.060"/>  <!-- MEASURE: bottom enclosure wall height -->
  <xacro:property name="ground_clearance" value="0.020"/>  <!-- MEASURE: floor to enclosure underside -->
  <xacro:property name="plate_thickness"  value="0.003"/>
  <xacro:property name="standoff_low"     value="0.050"/>  <!-- bottom -> middle layer -->
  <xacro:property name="standoff_high"    value="0.060"/>  <!-- middle -> top layer -->
  <xacro:property name="standoff_x"       value="0.060"/>
  <xacro:property name="standoff_y"       value="0.075"/>

  <!-- ===== Sensors ===== -->
  <xacro:property name="lidar_x"           value="0.0"/>
  <xacro:property name="lidar_yaw"         value="0.0"/>   <!-- checked 2026-11-24: scan matches the robot, no rotation needed -->
  <xacro:property name="lidar_scan_height" value="0.030"/> <!-- A1M8 base to scan plane -->
  <xacro:property name="imu_x"   value="0.0"/>             <!-- MPU9250 on NOVA-LLC board, bottom enclosure -->
  <xacro:property name="imu_y"   value="0.0"/>
  <xacro:property name="imu_rpy" value="0 0 0"/>           <!-- match chip axes to robot axes (x fwd, z up) -->

  <!-- ===== Masses (kg) ===== -->
  <xacro:property name="chassis_mass" value="0.90"/>  <!-- enclosure + motors + battery + PCB -->
  <xacro:property name="deck_mass"    value="0.30"/>  <!-- middle plate + Pi 5 + power bank -->
  <xacro:property name="top_mass"     value="0.20"/>  <!-- top plate + RPLidar -->
  <xacro:property name="wheel_mass"   value="0.05"/>
  <xacro:property name="caster_mass"  value="0.02"/>

  <!-- ===== Derived (do not edit) ===== -->
  <xacro:property name="enclosure_bottom_z" value="${ground_clearance - wheel_radius}"/>
  <xacro:property name="enclosure_top_z"    value="${enclosure_bottom_z + enclosure_height}"/>
  <xacro:property name="mid_plate_z"        value="${enclosure_top_z + standoff_low}"/>
  <xacro:property name="top_plate_z"        value="${mid_plate_z + plate_thickness + standoff_high}"/>

  <!-- ===== Materials ===== -->
  <material name="nova_body">   <color rgba="0.12 0.12 0.14 1.0"/></material>
  <material name="nova_plate">  <color rgba="0.95 0.55 0.10 1.0"/></material>
  <material name="nova_wheel">  <color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="nova_metal">  <color rgba="0.75 0.75 0.78 1.0"/></material>
  <material name="nova_pcb">    <color rgba="0.05 0.45 0.20 1.0"/></material>
  <material name="nova_lidar">  <color rgba="0.20 0.20 0.22 1.0"/></material>
  <material name="nova_bank">   <color rgba="0.85 0.85 0.85 1.0"/></material>

</robot>
