<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Four standoff visuals, drawn downward from the link origin -->
  <xacro:macro name="one_standoff" params="x y length">
    <visual>
      <origin xyz="${x} ${y} ${-length/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="0.003" length="${length}"/></geometry>
      <material name="nova_metal"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="standoffs" params="length">
    <xacro:one_standoff x="${standoff_x}"  y="${standoff_y}"  length="${length}"/>
    <xacro:one_standoff x="${standoff_x}"  y="${-standoff_y}" length="${length}"/>
    <xacro:one_standoff x="${-standoff_x}" y="${standoff_y}"  length="${length}"/>
    <xacro:one_standoff x="${-standoff_x}" y="${-standoff_y}" length="${length}"/>
  </xacro:macro>

  <!-- ================= base_footprint / base_link (bottom enclosure) ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${enclosure_bottom_z}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nova_description/meshes/hex_prism.stl"
              scale="${hex_length} ${hex_width} ${enclosure_height}"/>
      </geometry>
      <material name="nova_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${enclosure_bottom_z + enclosure_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${hex_width/2}" length="${enclosure_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${hex_length}" y="${hex_width}" z="${enclosure_height}">
      <origin xyz="0 0 ${enclosure_bottom_z + enclosure_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ================= Drive wheels ================= -->
  <xacro:macro name="drive_wheel" params="side y_sign">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_sign*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="nova_wheel"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- ================= Ball caster ================= -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="nova_metal"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <!-- ================= IMU (MPU9250 on NOVA-LLC board) ================= -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${enclosure_bottom_z + 0.020}" rpy="${imu_rpy}"/>
  </joint>
  <link name="imu_link">
    <visual>
      <geometry><box size="0.100 0.080 0.002"/></geometry>
      <material name="nova_pcb"/>
    </visual>
  </link>

  <!-- ================= Middle deck: Raspberry Pi 5 + power bank ================= -->
  <joint name="mid_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid_deck_link"/>
    <origin xyz="0 0 ${mid_plate_z}" rpy="0 0 0"/>
  </joint>
  <link name="mid_deck_link">
    <visual>
      <geometry>
        <mesh filename="package://nova_description/meshes/hex_prism.stl"
              scale="${hex_length} ${hex_width} ${plate_thickness}"/>
      </geometry>
      <material name="nova_plate"/>
    </visual>
    <xacro:standoffs length="${standoff_low}"/>
    <!-- Raspberry Pi 5 -->
    <visual>
      <origin xyz="0.035 0 ${plate_thickness + 0.012}" rpy="0 0 0"/>
      <geometry><box size="0.085 0.056 0.020"/></geometry>
      <material name="nova_pcb"/>
    </visual>
    <!-- Power bank -->
    <visual>
      <origin xyz="-0.055 0 ${plate_thickness + 0.009}" rpy="0 0 ${pi/2}"/>
      <geometry><box size="0.140 0.068 0.016"/></geometry>
      <material name="nova_bank"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${hex_width/2}" length="${plate_thickness}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${deck_mass}" x="${hex_length}" y="${hex_width}" z="0.02">
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ================= Top deck: RPLidar A1M8 ================= -->
  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck_link"/>
    <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0"/>
  </joint>
  <link name="top_deck_link">
    <visual>
      <geometry>
        <mesh filename="package://nova_description/meshes/hex_prism.stl"
              scale="${hex_length} ${hex_width} ${plate_thickness}"/>
      </geometry>
      <material name="nova_plate"/>
    </visual>
    <xacro:standoffs length="${standoff_high}"/>
    <collision>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${hex_width/2}" length="${plate_thickness}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${top_mass}" x="${hex_length}" y="${hex_width}" z="0.04">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="top_deck_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${plate_thickness}" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.010" rpy="0 0 0"/>
      <geometry><box size="0.097 0.070 0.020"/></geometry>
      <material name="nova_lidar"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.032" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.024"/></geometry>
      <material name="nova_lidar"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 ${lidar_scan_height}" rpy="0 0 ${lidar_yaw}"/>
  </joint>
  <link name="laser_frame"/>

</robot>
