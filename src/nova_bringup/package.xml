<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nova_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the real NOVA robot (Raspberry Pi 5) and the full simulation stack.</description>
  <maintainer email="todo@todo.com">Thirunavukkarasu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nova_description</exec_depend>
  <exec_depend>nova_base</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nova_web_bridge</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- used by sim_all.launch.py (laptop); nova_gazebo only installs files, so the Pi builds it too -->
  <exec_depend>nova_gazebo</exec_depend>
  <exec_depend>nova_navigation</exec_depend>
  <exec_depend>nova_mission</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
