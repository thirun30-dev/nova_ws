<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nova_web_bridge</name>
  <version>0.1.0</version>
  <description>Robot-side backend for the NOVA web dashboard: state, health, pose, nav status, locations, maps, mode switching and E-STOP over rosbridge.</description>
  <maintainer email="todo@todo.com">Thirunavukkarasu</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nova_interfaces</exec_depend>
  <exec_depend>nova_navigation</exec_depend>
  <exec_depend>nova_mission</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
